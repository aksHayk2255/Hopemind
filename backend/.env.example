# Copy this file to backend/.env for local configuration.
# Never commit backend/.env or real credentials.

FLASK_ENV=development
PORT=5000

# Use long, random values outside local development.
SECRET_KEY=replace-with-a-random-secret
JWT_SECRET_KEY=replace-with-a-different-random-secret
JWT_EXPIRE_HOURS=24

# SQLite is the default. For PostgreSQL, use:
# DATABASE_URL=postgresql://user:password@localhost:5432/hopemind
DATABASE_URL=sqlite:///hopemind.db

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional. Without a key, the app uses its local/mock chat behavior.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional path to a trained research artifact.
# ML_MODEL_PATH=
